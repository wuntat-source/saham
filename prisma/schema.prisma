generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password_hash String
  role          String         @default("student") // 'student' | 'teacher' | 'admin'
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  // Relations
  taughtClasses Class[]        @relation("TeacherClasses")
  enrolledClasses ClassMember[]
  wallet        Wallet?
  portfolios    Portfolio[]
  orders        Order[]
  transactions  Transaction[]
  strategies    Strategy[]

  @@map("users")
}

model Class {
  id              String        @id @default(uuid())
  teacher_id      String
  class_name      String
  invitation_code String        @unique
  initial_balance Float         @default(100000000.0)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // Relations
  teacher         User          @relation("TeacherClasses", fields: [teacher_id], references: [id], onDelete: Cascade)
  members         ClassMember[]

  @@map("classes")
}

model ClassMember {
  id         String   @id @default(uuid())
  class_id   String
  student_id String
  joined_at  DateTime @default(now())

  // Relations
  class      Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@map("class_members")
}

model Wallet {
  id              String   @id @default(uuid())
  user_id         String   @unique
  cash_balance    Float    @default(100000000.0)
  blocked_balance Float    @default(0.0)
  updated_at      DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Portfolio {
  id            String   @id @default(uuid())
  user_id       String
  stock_code    String
  total_shares  Int      @default(0)
  avg_buy_price Float    @default(0.0)
  updated_at    DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, stock_code])
  @@map("portfolios")
}

model Order {
  id           String        @id @default(uuid())
  user_id      String
  stock_code   String
  order_type   String        // 'BUY' | 'SELL'
  order_mode   String        // 'MARKET' | 'LIMIT'
  target_price Float
  lot_quantity Int
  status       String        @default("PENDING") // 'PENDING' | 'FILLED' | 'CANCELLED' | 'REJECTED'
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  // Relations
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("orders")
}

model Transaction {
  id               String   @id @default(uuid())
  order_id         String
  user_id          String
  stock_code       String
  type             String   // 'BUY' | 'SELL'
  price            Float
  lot_quantity     Int
  total_amount     Float
  broker_fee       Float
  total_settlement Float
  realized_pnl     Float    @default(0.0)
  executed_at      DateTime @default(now())

  // Relations
  order            Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// ==========================================
// PHASE 2 — AI STOCK INTELLIGENCE MODELS
// ==========================================

model Stock {
  id           String   @id @default(uuid())
  ticker       String   @unique
  company_name String
  sector       String
  industry     String
  market_cap   Float
  listed_at    DateTime?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  fundamentalMetrics FundamentalMetric[]
  valuationMetrics   ValuationMetric[]
  technicalMetrics   TechnicalMetric[]
  scores             StockScore[]
  rankings           StockRanking[]
  sentimentArticles  SentimentArticle[]

  @@map("stocks")
}

model FundamentalMetric {
  id                   String   @id @default(uuid())
  stock_id             String
  period               String   // 'FY2024' | 'Q3-2024' etc.
  revenue              Float?
  revenue_growth       Float?
  gross_profit         Float?
  operating_profit     Float?
  net_profit           Float?
  eps                  Float?
  eps_growth           Float?
  roe                  Float?
  roa                  Float?
  roic                 Float?
  debt                 Float?
  cash                 Float?
  free_cash_flow       Float?
  operating_cash_flow  Float?
  data_as_of          DateTime @default(now())
  source               String   @default("IDX / Financial Report")

  // Relations
  stock                Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("fundamental_metrics")
}

model ValuationMetric {
  id             String   @id @default(uuid())
  stock_id       String
  period         String
  pe             Float?
  forward_pe     Float?
  pbv            Float?
  ev_ebitda      Float?
  psr            Float?
  peg            Float?
  dividend_yield Float?
  fcf_yield      Float?
  data_as_of     DateTime @default(now())
  source         String   @default("Market Data Provider")

  // Relations
  stock          Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("valuation_metrics")
}

model TechnicalMetric {
  id              String   @id @default(uuid())
  stock_id        String
  timestamp       DateTime @default(now())
  sma20           Float?
  sma50           Float?
  sma100          Float?
  sma200          Float?
  ema             Float?
  rsi             Float?
  macd            Float?
  macd_signal     Float?
  macd_histogram  Float?
  stochastic      Float?
  adx             Float?
  atr             Float?
  bollinger_upper Float?
  bollinger_lower Float?
  bollinger_mid   Float?
  obv             Float?
  trend_signal    String?  // 'UPTREND' | 'DOWNTREND' | 'SIDEWAYS' | 'BREAKOUT' | 'BREAKDOWN'

  // Relations
  stock           Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("technical_metrics")
}

model StockScore {
  id                  String   @id @default(uuid())
  stock_id            String
  fundamental_score   Float
  technical_score     Float
  valuation_score     Float
  smart_money_score   Float
  sentiment_score     Float
  risk_score          Float
  overall_score       Float
  confidence_score    Float
  data_quality_score  Float
  market_regime_score Float    @default(75.0)
  calculated_at       DateTime @default(now())
  engine_version      String   @default("v2.1.0-ai")

  // Relations
  stock               Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("stock_scores")
}

model StockRanking {
  id               String   @id @default(uuid())
  stock_id         String
  rank             Int
  score            Float
  confidence       Float
  catalyst         String?
  main_risk        String?
  strongest_pillar String?
  weakest_pillar   String?
  ranking_date     DateTime @default(now())
  engine_version   String   @default("v2.1.0-ai")

  // Relations
  stock            Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("stock_rankings")
}

model SentimentArticle {
  id           String   @id @default(uuid())
  stock_id     String
  headline     String
  summary      String
  source       String
  published_at DateTime
  sentiment    String   // 'positive' | 'neutral' | 'negative'
  score        Float    // 0-100
  confidence   Float    @default(85.0)

  // Relations
  stock        Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("sentiment_articles")
}

// ==========================================
// PHASE 3 — ADVANCED AI MARKET MODELS
// ==========================================

model Catalyst {
  id              String   @id @default(uuid())
  ticker          String
  event_type      String   // 'EARNINGS' | 'DIVIDEND' | 'RUPS' | 'BUYBACK' | 'ACQUISITION' | 'CONTRACT' | 'EXPANSION' | 'REGULATION' | 'INDEX_REBALANCE' | 'OTHER'
  title           String
  description     String
  event_date      DateTime
  expected_impact String   // 'HIGH_POSITIVE' | 'MODERATE_POSITIVE' | 'NEUTRAL' | 'MODERATE_NEGATIVE' | 'HIGH_NEGATIVE'
  confidence      Float    @default(85.0)
  source          String   @default("Keterbukaan Informasi BEI")
  created_at      DateTime @default(now())

  @@map("catalysts")
}

model Anomaly {
  id               String   @id @default(uuid())
  ticker           String
  anomaly_type     String   // 'ABNORMAL_VOLUME' | 'ABNORMAL_PRICE_MOVEMENT' | 'ABNORMAL_VOLATILITY' | 'PRICE_VOLUME_DIVERGENCE' | 'UNUSUAL_FLOW' | 'FUNDAMENTAL_ANOMALY'
  severity         String   // 'NORMAL' | 'WATCH' | 'WARNING' | 'HIGH_ALERT'
  description      String
  detected_metric  Float?
  baseline_metric  Float?
  confidence       Float    @default(85.0)
  detected_at      DateTime @default(now())

  @@map("anomalies")
}

// ==========================================
// PHASE 4 — AI MENTOR, JOURNAL & LEARNING MODELS
// ==========================================

model TradingJournal {
  id             String        @id @default(uuid())
  user_id        String
  transaction_id String?
  ticker         String
  thesis         String
  entry_reason   String?
  risk_reason    String?
  target         Float?
  stop_loss      Float?
  market_regime  String?
  created_at     DateTime      @default(now())

  // Relations
  reviews        TradeReview[]

  @@map("trading_journals")
}

model TradeReview {
  id               String         @id @default(uuid())
  journal_id       String
  user_id          String
  decision_quality Float          @default(75.0) // 0-100
  entry_quality    Float          @default(75.0) // 0-100
  risk_management  Float          @default(80.0) // 0-100
  timing           Float          @default(70.0) // 0-100
  thesis_quality   Float          @default(75.0) // 0-100
  outcome_score    Float          @default(70.0) // 0-100
  what_well        String
  what_improve     String
  what_happened    String
  key_lesson       String
  created_at       DateTime       @default(now())

  // Relations
  journal          TradingJournal @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@map("trade_reviews")
}

model StudentSkill {
  id                    String   @id @default(uuid())
  user_id               String   @unique
  fundamental_score     Float    @default(65.0)
  technical_score       Float    @default(65.0)
  valuation_score       Float    @default(60.0)
  risk_management_score Float    @default(75.0)
  portfolio_score       Float    @default(70.0)
  psychology_score      Float    @default(70.0)
  literacy_score        Float    @default(80.0)
  research_score        Float    @default(70.0)
  decision_score        Float    @default(72.0)
  learning_score        Float    @default(71.0)
  updated_at            DateTime @updatedAt

  @@map("student_skills")
}

model LearningProgress {
  id                    String   @id @default(uuid())
  user_id               String   @unique
  xp                    Int      @default(150)
  level                 Int      @default(1)
  streak_days           Int      @default(3)
  completed_lessons     Int      @default(2)
  completed_assignments Int      @default(1)
  journal_count         Int      @default(0)
  last_active_at        DateTime @default(now())

  @@map("learning_progress")
}

model Assignment {
  id              String                 @id @default(uuid())
  class_id        String
  teacher_id      String
  title           String
  description     String
  deadline        DateTime
  stock_universe  String                 @default("LQ45 / Kompas100")
  required_output String
  created_at      DateTime               @default(now())

  // Relations
  submissions     AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id                 String     @id @default(uuid())
  assignment_id      String
  student_id         String
  content            String
  grade              Float?
  feedback           String?
  ai_score           Float?
  ai_evaluation_json String?
  research_quality   Float?
  evidence_quality   Float?
  reasoning_score    Float?
  risk_awareness     Float?
  submitted_at       DateTime   @default(now())

  // Relations
  assignment         Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@map("assignment_submissions")
}

model Challenge {
  id          String   @id @default(uuid())
  class_id    String
  teacher_id  String
  title       String
  type        String   // 'PORTFOLIO' | 'FUNDAMENTAL' | 'TECHNICAL' | 'RISK' | 'RESEARCH'
  description String
  start_date  DateTime @default(now())
  end_date    DateTime
  reward_xp   Int      @default(250)

  @@map("challenges")
}

model Badge {
  id          String   @id @default(uuid())
  user_id     String
  badge_type  String   // 'FUNDAMENTAL_EXPLORER' | 'TECHNICAL_ANALYST' | 'RISK_MANAGER' | etc.
  title       String
  description String
  unlocked_at DateTime @default(now())

  @@unique([user_id, badge_type])
  @@map("badges")
}

model MentorMessage {
  id         String   @id @default(uuid())
  user_id    String
  role       String   // 'user' | 'assistant'
  content    String
  created_at DateTime @default(now())

  @@map("mentor_messages")
}

// --- PHASE 5: QUANT LAB & BACKTESTING ---

model Strategy {
  id          String     @id @default(uuid())
  user_id     String
  name        String
  description String
  rules_json  String     // JSON serialized quantitative rules
  universe    String     @default("LQ45")
  timeframe   String     @default("1D")
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  // Relations
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  backtests   Backtest[]

  @@map("strategies")
}

model Backtest {
  id                 String          @id @default(uuid())
  strategy_id        String
  start_date         DateTime
  end_date           DateTime
  initial_capital    Float           @default(100000000.0)
  final_equity       Float
  total_return       Float           // %
  cagr               Float           // %
  win_rate           Float           // %
  max_drawdown       Float           // %
  sharpe_ratio       Float
  sortino_ratio      Float
  profit_factor      Float
  total_trades       Int
  equity_curve_json  String          // JSON daily portfolio equity series
  walk_forward_json  String?         // JSON in-sample & out-of-sample breakdown
  ai_review_json     String?         // JSON AI qualitative strategy evaluation
  created_at         DateTime        @default(now())

  // Relations
  strategy           Strategy        @relation(fields: [strategy_id], references: [id], onDelete: Cascade)
  trades             BacktestTrade[]

  @@map("backtests")
}

model BacktestTrade {
  id          String   @id @default(uuid())
  backtest_id String
  ticker      String
  entry_date  DateTime
  entry_price Float
  exit_date   DateTime
  exit_price  Float
  shares      Int      // 1 lot = 100 shares
  fees        Float
  gross_pnl   Float
  net_pnl     Float
  exit_reason String   // 'TAKE_PROFIT' | 'STOP_LOSS' | 'TECHNICAL_EXIT' | 'TIME_EXIT'

  // Relations
  backtest    Backtest @relation(fields: [backtest_id], references: [id], onDelete: Cascade)

  @@map("backtest_trades")
}

// --- PHASE 6: CLASSROOM INTELLIGENCE & SCHOOL PLATFORM ---

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String   // e.g. 'BALANCE_CHANGE', 'ROLE_UPDATE', 'CLASS_JOIN', 'CERTIFICATE_ISSUE'
  entity     String   // e.g. 'Wallet', 'User', 'Class', 'Assignment'
  entity_id  String?
  old_value  String?
  new_value  String?
  timestamp  DateTime @default(now())
  ip_hash    String?

  @@map("audit_logs")
}

model AIGovernanceLog {
  id             String   @id @default(uuid())
  user_id        String?
  engine_type    String   // e.g. 'SOCRATIC_MENTOR', 'TRADE_REVIEW', 'ASSIGNMENT_EVAL', 'STRATEGY_REVIEW'
  prompt_version String   @default("v2.1")
  model_version  String   @default("gemini-2.5-flash")
  input_tokens   Int      @default(0)
  output_tokens  Int      @default(0)
  latency_ms     Int      @default(0)
  timestamp      DateTime @default(now())

  @@map("ai_governance_logs")
}

model Certificate {
  id              String   @id @default(uuid())
  user_id         String
  class_id        String?
  issued_by       String   // Teacher / Admin user ID
  title           String
  category        String   // 'FUNDAMENTAL' | 'TECHNICAL' | 'RISK' | 'PORTFOLIO' | 'QUANT' | 'EXPLORER'
  grade           String   @default("DISTINCTION") // 'DISTINCTION' | 'MERIT' | 'PASS'
  credential_code String   @unique
  issued_at       DateTime @default(now())

  @@map("certificates")
}

// ==========================================
// FEATURE MODULE — AI INVESTMENT LENS
// ==========================================

model InvestmentLensScore {
  id             String   @id @default(uuid())
  ticker         String
  lens_type      String   // 'INSTITUTIONAL' | 'LONG_TERM_QUALITY' | 'FUNDAMENTAL_GROWTH' | 'MACRO_CATALYST' | 'EARNINGS_EXPECTATIONS' | 'QUALITY_COMPOUNDER'
  score          Float    // 0-100
  confidence     Float    // 0-100
  data_quality   String   @default("HIGH") // 'HIGH' | 'MEDIUM' | 'STALE' | 'INSUFFICIENT'
  calculated_at  DateTime @default(now())
  data_as_of     DateTime @default(now())
  engine_version String   @default("v2.2-lens")

  @@unique([ticker, lens_type])
  @@map("investment_lens_scores")
}

model InvestmentLensAnalysis {
  id               String   @id @default(uuid())
  ticker           String
  lens_type        String
  business_quality Float    @default(70.0)
  growth_score     Float    @default(70.0)
  valuation_score  Float    @default(70.0)
  risk_score       Float    @default(70.0)
  catalyst_score   Float    @default(70.0)
  overall_score    Float    // 0-100
  confidence       Float    @default(85.0)
  thesis           String
  strengths_json   String   // JSON string array
  weaknesses_json  String   // JSON string array
  risks_json       String   // JSON string array
  scenarios_json   String?  // JSON object of bull/base/bear cases
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([ticker, lens_type])
  @@map("investment_lens_analysis")
}




